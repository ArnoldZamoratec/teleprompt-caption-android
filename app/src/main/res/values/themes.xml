<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GlassPrompt" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/glass_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.GlassPrompt.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/glass_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.GlassPrompt</item>
    </style>
</resources>
